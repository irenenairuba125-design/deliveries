# Copy to .env in the repo root. The server and Vite both read it.
# Everything is optional in development; see README "Going live" for production.

# ---------- core ----------
PORT=4000
# NODE_ENV=production                # disables sandbox payments and demo seeding
AUTH_SECRET=change-me-to-at-least-32-random-characters
# CORS_ORIGIN=https://app.example.com
# TRUST_PROXY=1                      # behind a load balancer / reverse proxy
# SEED_DEMO=1                        # seed demo data in production (not recommended)

# ---------- database ----------
# Unset = SQLite file at server/data/food.db
# DATABASE_URL=postgres://chakula:secret@localhost:5432/chakula
# PG_SSL=1                           # managed Postgres with TLS
# PG_POOL_MAX=10
# POSTGIS=0                          # don't try to enable PostGIS

# ---------- redis (BullMQ jobs, multi-instance sockets, shared rate limits) ----------
# REDIS_URL=redis://localhost:6379

# ---------- maps & routing ----------
# MAPBOX_TOKEN=pk.xxx                # server: traffic-aware routing
# OSRM_URL=https://router.project-osrm.org   # or "off"
# VITE_MAPBOX_TOKEN=pk.xxx           # client: Mapbox tiles

# ---------- payments ----------
# Any method without credentials runs in simulated sandbox mode (dev only),
# or is hidden at checkout when NODE_ENV=production.
# PAYMENTS_SANDBOX=1                 # allow simulated payments in production (staging)
# PAYMENTS_CASH=0                    # disable cash on delivery

# Stripe (cards)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx    # endpoint: POST /api/payments/webhook/stripe
# STRIPE_CURRENCY=ugx

# MTN Mobile Money — Collections product (momodeveloper.mtn.com)
# MOMO_SUBSCRIPTION_KEY=xxx
# MOMO_API_USER=uuid
# MOMO_API_KEY=xxx
# MOMO_TARGET_ENV=sandbox            # mtnuganda in production
# MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com   # https://proxy.momoapi.mtn.com in production
# MOMO_CURRENCY=EUR                  # sandbox only accepts EUR; UGX in production
# MOMO_CALLBACK_URL=https://api.example.com/api/payments/webhook/mtn_momo
# Optional Disbursement product, for automatic refunds:
# MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=xxx
# MOMO_DISBURSEMENT_API_USER=uuid
# MOMO_DISBURSEMENT_API_KEY=xxx

# Airtel Money — Collections API (developers.airtel.africa)
# AIRTEL_CLIENT_ID=xxx
# AIRTEL_CLIENT_SECRET=xxx
# AIRTEL_ENV=uat                     # production for live
# AIRTEL_COUNTRY=UG
# AIRTEL_CURRENCY=UGX
# Callback URL to register in the Airtel portal: https://api.example.com/api/payments/webhook/airtel_money
